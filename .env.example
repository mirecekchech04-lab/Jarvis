# ── J.A.R.V.I.S. configuration ────────────────────────────────────────────
# Copy this file to `.env` and fill in your values, then run `npm start`.

# Port the server listens on.
PORT=3000

# The AI brain. JARVIS talks to any OpenAI-compatible chat completions API.
# Get a key from https://platform.openai.com/ (or point at a local server).
#
# If you leave OPENAI_API_KEY empty, JARVIS still runs and replies using a
# built-in offline personality engine (limited, but fully functional).

OPENAI_API_KEY=
# Base URL of the API (change to use OpenRouter, Groq, a local LLM, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
# Which model to use.
OPENAI_MODEL=gpt-4o-mini

# The name your assistant answers to (used in the personality prompt).
ASSISTANT_NAME=JARVIS
# Who JARVIS is serving (personalises replies, e.g. "sir", "Tony", your name).
USER_TITLE=sir
